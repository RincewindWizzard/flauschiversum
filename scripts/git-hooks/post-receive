#!/usr/bin/env bash
# Git-Hook für Umgebungen ohne GitHub Actions (eigener Git-Server): deployt bei einem Push auf master.
# Installation: scripts/install-git-hook.sh <Pfad zum Bare-Repository>
#
# Der Hook baut nicht selbst, sondern bittet per sudo den festen Befehl deploy-commit, den gepushten Commit als eigener
# Benutzer `flauschiversum` zu bauen und zu deployen (Einrichtung: README, "Server für das Deployment einrichten").
# Die Ausgabe sieht der Pusher ("remote: …"). Deployt wird nur ein Push auf den Hauptbranch des Repositorys (HEAD, z. B. main); Pushes auf andere Branches tun nichts.
# Für Tests ersetzbar: DEPLOY_REF, DEPLOY_USER, DEPLOY_SUDO, DEPLOY_COMMIT_COMMAND.
set -uo pipefail

# Hauptbranch = der Branch, auf den HEAD des Repositorys zeigt (git symbolic-ref HEAD); DEPLOY_REF überschreibt das.
wanted_ref="${DEPLOY_REF:-$(git symbolic-ref -q HEAD || echo refs/heads/main)}"
user="${DEPLOY_USER:-flauschiversum}"
sudo_cmd="${DEPLOY_SUDO:-sudo}"
command_path="${DEPLOY_COMMIT_COMMAND:-/usr/local/libexec/flauschiversum/deploy-commit}"

status=0
while read -r _ new ref; do
  [ "$ref" = "$wanted_ref" ] || continue
  case "$new" in
    0000000*) echo "Branch gelöscht: nichts zu deployen."; continue ;;
  esac
  echo "==> Deployment von ${new:0:10} ($ref) als Benutzer $user"
  if "$sudo_cmd" -n -u "$user" "$command_path" "$new"; then
    echo "==> Deployment erfolgreich."
  else
    echo "==> Deployment FEHLGESCHLAGEN. Die Seite auf dem Server ist unverändert oder auf dem vorigen Stand." >&2
    echo "    Protokoll: ~$user/.cache/flauschiversum/deploy.log. Falls sudo nichts ausführen durfte:" >&2
    echo "    Einrichtung prüfen (README, \"Server für das Deployment einrichten\", Schritt sudoers)." >&2
    status=1
  fi
done
exit "$status"
