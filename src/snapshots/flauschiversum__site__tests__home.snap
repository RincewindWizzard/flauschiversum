  <nav class="center">
    <a href="/">Start</a>
    <a href="/themen/">Themen</a>
    <a href="/beitraege/">Beiträge</a>
    <a href="/tipps-und-tricks/">Tipps und Tricks</a>
    <a href="/about/">About</a>
    <a href="/impressum/">Impressum</a>
    <a href="/rss.xml">Abonnieren</a>
  </nav>
  
</header>

<main id="home">
  <section class="home-search" aria-label="Suche">
    <form class="search big" action="/suche/" method="get" role="search">
      <label for="q">Was möchtest du machen?</label>
      <div class="search-row">
        <input type="search" id="q" name="q" placeholder="z.B. Mütze, Katze, Filz …" autocomplete="off">
        <button type="submit">Suchen</button>
      </div>
    </form>
  </section>

  <section class="categories" aria-labelledby="kategorien">
    <h2 id="kategorien">Kategorien</h2>
    <ul class="tiles">
      <li><a class="tile" href="/kategorie/basteln/">
        <img src="/images/basteln.jpg" alt="" loading="lazy">
        <span class="tile-name">Basteln</span>
        <span class="tile-motto">Papier und Schere,
mehr brauchst du nicht.</span>
        <span class="tile-count">2 Beiträge</span>
      </a></li>
    </ul>
  </section>

  <section class="topics" aria-labelledby="themen">
    <h2 id="themen">Häufige Themen</h2>
    <ul class="taglist">
      <li><a href="/tag/huete/">Hüte <span class="count">(3)</span></a></li>
      <li><a href="/tag/larp/">LARP <span class="count">(2)</span></a></li>
      <li><a href="/tag/halloween/">Halloween <span class="count">(1)</span></a></li>
      <li class="all"><a href="/themen/">Alle Themen</a></li>
    </ul>
  </section>

  <section class="news" aria-labelledby="neu">
